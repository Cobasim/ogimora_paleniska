# OGIMORA - po wgraniu poprawki przegladarki maja od razu brac nowe pliki (pytaja serwer, czy plik sie zmienil).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|css|json|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Serwer OVH nie zna rozszerzenia .mjs - bez tego przegladarka nie uruchomi modulu (strona stoi z rozmytym podgladem).
AddType application/javascript .mjs
